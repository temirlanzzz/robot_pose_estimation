{
  "name": "robot-pose-visualizer",
  "version": "1.0.0",
  "description": "Interactive 3R robot kinematics lab with analytic IK and URDF export",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.11",
    "gsap": "^3.15.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "gh-pages": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "keywords": [
    "react",
    "three.js",
    "robotics",
    "kinematics",
    "inverse-kinematics"
  ],
  "author": "Temirlan Zarymkanov",
  "homepage": "https://temirlanzzz.github.io/robot_pose_estimation",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
